# Sao chép thành .env, dùng chuỗi hex ngẫu nhiên để mật khẩu luôn hợp lệ trong URL
APP_HOST=localhost
# Đặt URL đầy đủ khi dùng cổng HTTPS khác 443
PUBLIC_APP_URL=https://localhost
RELEASE_TAG=local
RUNTIME_ENV=production
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET=
INITIAL_ACCOUNT_PASSWORD=
STORAGE_ENABLED=false
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=evidences
SUPABASE_URL=
SUPABASE_KEY=
HTTP_BIND=80
HTTPS_BIND=443

# Seed là lệnh riêng, không chạy tự động
SEED_ADMIN_PASSWORD=
SEED_DEMO_ENABLED=false
