{$APP_HOST:localhost} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    -Server
  }
  request_body {
    max_size 12MB
  }
  handle /api/* {
    reverse_proxy backend:3000
  }
  handle {
    reverse_proxy frontend:8080
  }
}
