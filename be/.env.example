# Môi trường và máy chủ
NODE_ENV=development
PORT=3000
DB_POOL_MAX=20
# Cache GET: đường ghi và auth/me luôn kiểm DB. TTL 0 để tắt cache.
AUTH_CACHE_TTL_MS=3000
DASHBOARD_CACHE_TTL_MS=5000
NOTIFICATION_WORKER_CONCURRENCY=5
CREDENTIAL_WORKER_CONCURRENCY=5
WORKER_BUDGET_MS=4000
BACKGROUND_JOBS_ENABLED=true
# GET /metrics yêu cầu Authorization: Bearer <METRICS_TOKEN>
METRICS_ENABLED=false
METRICS_TOKEN=
WEB_ORIGINS=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/kpi_db?schema=public"
# Chỉ bật công cụ chạy scheduler thủ công trong môi trường demo được kiểm soát
ENABLE_DEMO_TOOLS=false

# Auth và cấp tài khoản
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=seminar
JWT_AUDIENCE=seminar-client
INITIAL_ACCOUNT_PASSWORD=123456
# Khóa AES-256-GCM: tạo 32 byte ngẫu nhiên rồi mã hóa base64 trước khi bật Email hoặc Push
CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:5173

# Web Push
WEB_PUSH_ENABLED=false
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,wns2-pn1p.notify.windows.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Email: smtp, apps_script hoặc resend (API HTTPS cho gửi hàng loạt)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_REQUIRED=true
SMTP_ALLOW_INSECURE_LOCAL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Zalo ZNS: mặc định tắt, không yêu cầu secret khi tắt
ZALO_ZNS_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_TEMPLATE_MAP=

# Kho private dev thật ngoài static root, chỉ bật khi cần upload minh chứng
STORAGE_ENABLED=false
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.private-storage
STORAGE_BUCKET=evidences
# Demo Supabase cần bucket private và service key ở BE, không đưa khóa vào FE
SUPABASE_URL=
SUPABASE_KEY=

# Kho báo cáo private local thật, không serve static hoặc đặt trong thư mục công khai của FE
REPORT_EXPORT_DIR=./storage/report-exports
REPORT_EXPORT_PROVIDER=local
# Để trống để dùng STORAGE_BUCKET khi chọn supabase; bucket phải private.
REPORT_EXPORT_BUCKET=
# Để trống dùng Noto Sans Unicode đóng gói cùng ứng dụng, chỉ đặt đường dẫn khi cần thay font
REPORT_EXPORT_FONT_PATH=
# URL tải chỉ sống 30–300 giây và luôn cần access token ADMIN còn hiệu lực
REPORT_EXPORT_DOWNLOAD_TTL_SECONDS=120
# Xuất OpenAPI và cấu hình seed riêng, không dùng các giá trị này làm nội dung báo cáo
OPENAPI_OUTPUT_FILE=
SEED_CREDENTIALS_FILE=.seed-credentials.json
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEED
SEED_ROTATE_PASSWORDS=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@seminar.local

# Hardening: proxy mặc định không tin header chuyển tiếp; production tắt Swagger
TRUST_PROXY=
RATE_LIMIT_ENABLED=true
SWAGGER_ENABLED=true

# Chỉ bật khi chạy db:seed:demo trên DB local/demo riêng
SEED_DEMO_ENABLED=false

# Reset chỉ DB local tên seminar_demo[_hậu_tố], không dùng DB hiện hữu/chia sẻ
ALLOW_DEMO_RESET=false
RESET_DEMO_DATABASE=
