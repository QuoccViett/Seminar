PORT=3000
WEB_ORIGINS=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/kpi_db?schema=public"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INITIAL_ACCOUNT_PASSWORD=123456
# Khóa AES-256-GCM dùng cho payload cấp credential, tạo 32 byte ngẫu nhiên rồi mã hóa base64 trước khi bật Email hoặc Push
CREDENTIALS_ENCRYPTION_KEY=
# Origin FE công khai để tạo link mời một lần, không thêm dấu gạch cuối
PUBLIC_APP_URL=http://localhost:5173
WEB_PUSH_ENABLED=false
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_AUTH_REQUIRED=true
# Chỉ bật cùng Mailpit ở localhost trong development hoặc test, production luôn yêu cầu TLS
SMTP_ALLOW_INSECURE_LOCAL=false
ZALO_ZNS_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_TEMPLATE_MAP=
STORAGE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-public-vapid-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-private-vapid-key
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Chỉ thêm host push service được phép sau khi kiểm tra nguồn và nhu cầu trình duyệt
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,wns2-pn1p.notify.windows.com
REPORT_EXPORT_DIR=report-exports
# REPORT_EXPORT_FONT_PATH=/path/to/a-unicode-font.ttf
#Tạo file json chứa 34 tài khoản con + 1 tài khoản admin, mật khẩu được tạo ngẫu nhiên
#Chi tiết đọc file BE_hướng dẫn (chỉ cần tạo 1 lần, nếu đã tạo file json rồi không cần tạo nữa vào những lần sau)
SEED_CREDENTIALS_FILE=.seed-credentials.json
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEED

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=seminar
JWT_AUDIENCE=seminar-client

# Gmail SMTP, đặt EMAIL_ENABLED=true khi kiểm thử
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Tài khoản Gmail gửi email
SMTP_USER=your-email@gmail.com

# Mật khẩu ứng dụng vừa tạo
SMTP_PASS=YOUR_APP_PASSWORD

# Địa chỉ người gửi
SMTP_FROM=your-email@gmail.com

# web push VAPID keys, tạo bằng lệnh `npx web-push generate-vapid-keys` hoặc dùng công cụ online
VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY
VAPID_SUBJECT=mailto:viett061205@gmail.com
# Zalo ZNS
ZNS_ENABLED=false