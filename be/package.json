{
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "start:dev": "node scripts/watch-dev.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "node scripts/reset-demo.mjs",
    "db:seed": "npm run db:seed:base",
    "db:verify:vc03": "node --import tsx --test test/integration/vc03.database.test.ts test/integration/vc03.auth.test.ts",
    "test": "npm run test:unit",
    "test:e2e": "node scripts/run-tests.mjs test/e2e .e2e.test.ts",
    "test:unit": "node scripts/run-tests.mjs src .spec.ts,.spec.js",
    "test:cov": "node scripts/run-tests.mjs src .spec.ts,.spec.js --coverage",
    "test:vc17": "c8 --config .c8rc.vc17.json node scripts/run-vc17.mjs",
    "db:seed:base": "tsx prisma/seed-base.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "test:supabase": "node scripts/verify-supabase.mjs",
    "load:seed": "node scripts/load-test-fixture.mjs",
    "load:verify": "node scripts/load-test-fixture.mjs --verify"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.12.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jszip": "^3.10.2",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.7",
    "@types/web-push": "^3.6.4",
    "c8": "^12.0.0",
    "eslint": "^9.39.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "^1.65.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0",
    "minimatch": "11.0.4",
    "effect": "3.22.5",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "test-exclude": {
      "glob": "14.0.6"
    }
  }
}
